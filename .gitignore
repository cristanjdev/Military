# Use docs/* (not docs/) so the negation below can re-include a single file.
# Git cannot re-include a file when its parent directory itself is excluded.
docs/*
!docs/SYSTEM-GAP-FINDINGS-AND-IMPLEMENTATION-NOTES.md

# IoT device secrets: Wi-Fi password and shared HMAC secret live in config.h
iot/firmware/**/config.h
# Compiled firmware (Arduino "Export compiled binary" / arduino-cli -e): it embeds config.h's secrets
iot/firmware/**/build/
# Biometric bridge: local secret + build output
biometric-bridge/bridge.settings.json
biometric-bridge/bin/
biometric-bridge/obj/
# QR decoder binary, copied from node_modules by frontend/scripts/copy-zxing-wasm.mjs
frontend/public/zxing_reader.wasm
